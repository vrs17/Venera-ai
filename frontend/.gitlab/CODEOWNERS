# CODEOWNERS — required reviewers for critical paths.
# Enforced once `main` is a protected branch with "Code owner approval required".
# Replace the @brb/* placeholders with your real GitLab groups/usernames.
#
# Rule: the author of an MR cannot approve their own code-owned change, so these
# paths always get a second set of eyes from platform/security.

# CI/CD definition and any change to how things build/deploy
/.gitlab-ci.yml          @brb/platform @brb/appsec
/Dockerfile              @brb/platform
/.dockerignore           @brb/platform

# Deployment, serving and runtime configuration
/deploy/                 @brb/platform @brb/appsec

# Security posture and documented blockers
/SECURITY.md             @brb/appsec
/deploy/ENTERPRISE.md    @brb/platform @brb/appsec

# Build/runtime config that affects the shipped bundle or proxy
/vite.config.ts          @brb/platform
*.conf                   @brb/platform

# Venera API - muhit o'zgaruvchilari
# Nusxa oling:  cp .env.example .env
# `.env` git'ga TUSHMAYDI.

# Token imzolash kaliti. PRODUCTION'DA ALBATTA O'ZGARTIRING:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# Token amal qilish muddati (soat)
TOKEN_TTL_HOURS=12

# Batafsil log
DEBUG=false

# CORS - odatda BO'SH qoldiriladi. nginx frontend va /api ni bir xil
# originda ko'rsatadi, ya'ni CORS kerak emas. Faqat frontend boshqa
# domenda ishlasa to'ldiring, masalan:
# CORS_ORIGINS=["http://localhost:5173"]

# --- TTS (matnni ovozga o'girish) ---
# Sir TTS serverining `backend/server/.env` -> AUTH_CLIENTS dan olinadi.
# BO'SH qoldirilsa ovoz sintezi o'chiq bo'ladi (endpoint 503), qolgan
# hamma narsa ishlayveradi. Bu qiymat GIT'GA HECH QACHON TUSHMAYDI.
TTS_CLIENT_ID=frontend
TTS_CLIENT_SECRET=
# Ovoz: uz_female_calm (ayol) | uz_male_news (erkak)
TTS_VOICE=uz_female_calm
# Bo'lakning maqsadli davomiyligi (soniya). Jonli suhbat uchun 1.0-2.0.
TTS_CHUNK_SEC=1.5

# --- Uyg'otish so'zi jurnali ---
# Har urinish diskka yoziladi: audio + transkript + qaror. OVOZ YOZUVLARI
# SHAXSIY MA'LUMOT - papka .gitignore da. Kerak bo'lmasa false qo'ying.
WAKE_LOG_ENABLED=true
WAKE_LOG_MAX_FILES=500

# --- HR Assistant (savol-javob) ---------------------------------------------
# BRB-TECH HR Assistant API: hujjatlar bo'yicha RAG + HRM, bitta
# `/api/chat/stream` endpointi ortida. CHAT AYNAN SHU XIZMAT BILAN ISHLAYDI -
# kredensial bo'lmasa `/api/health` ogohlantiradi va savol yuborilmaydi.
#
# Bu ILOVANING kredensiali (foydalanuvchining login/paroli EMAS): xizmat
# uni `X-Client-Id` / `X-Client-Secret` sarlavhalarida kutadi. Sir
# BRAUZERGA HECH QACHON berilmaydi - frontend faqat Venera'ning o'z
# `/api/v1/chat/stream` yo'liga boradi.
HRM_ASSISTANT_BASE_URL=http://10.10.50.4:8080
HRM_ASSISTANT_CLIENT_ID=
HRM_ASSISTANT_CLIENT_SECRET=
# Kadrlar ORASIDAGI eng uzun tanaffus (soniya), butun javob vaqti emas.
HRM_ASSISTANT_TIMEOUT=120
# Yuqorida bitta LLM turadi - bu bizning ulushimiz.
HRM_ASSISTANT_MAX_CONCURRENT=4
# HRM sessiya token'i (JWT) - JONLI HRM ma'lumoti uchun ("men bugun
# kechikdimmi?"). Bo'sh bo'lsa bunday savollar "HRM hisobingiz ulanmagan"
# javobini beradi, hujjatlar bo'yicha savollar esa ishlaydi.
#
# DIQQAT, VAQTINCHALIK: bu BITTA UMUMIY token. Xizmat uni "so'rayotgan
# odamning o'z sessiyasi" deb qabul qiladi, ya'ni token bilan "men" degani
# TOKEN EGASI - har qanday foydalanuvchi so'rasa javob o'sha odam haqida
# bo'ladi. Muddati tugagach yangilash kerak. Doimiy yechim: foydalanuvchi
# o'z HRM hisobi bilan kirsin.
HRM_TOKEN=

# --- CRM sessiyasi -----------------------------------------------------------
# CRM ham 2026-09-14 dan boshlab jonli javob beradi ("mening ochiq
# tasklarim qaysi?"). Uning `access_token` i 300 SEKUND yashaydi, ya'ni
# QO'LDA yozish amalda ishlamaydi: nusxalab, yopishtirib, saqlab
# bo'lguncha muddati tugaydi.
#
# Shu sababli Venera o'zi login qiladi va `refresh_token` bilan yashaydi:
# bir marta parol bilan kiradi, keyin har ~4 daqiqada tokenni o'zi
# yangilaydi va parolga boshqa qaytmaydi.
#
# Pastdagi uchtasi to'lgan zahoti avtomatik sessiya ishga tushadi va
# qo'lda yozilgan CRM_TOKEN e'tiborga olinmaydi.
CRM_BASE_URL=
# AGENTNING O'Z CRM hisobi - odamning hisobi EMAS.
#
# Ikki sabab: hisobning roli agent nimani o'qib-o'zgartira olishini
# belgilaydi (zarar doirasi kichik qoladi), va audit jurnali halol
# bo'ladi - aks holda agentning har bir harakati kimning parolini olgan
# bo'lsa o'sha odamga yozilardi.
CRM_USERNAME=
CRM_PASSWORD=
CRM_TIMEOUT=10
# CRM sessiya token'i - FAQAT ZAHIRA, yuqoridagi uchtasi bo'sh bo'lganda.
# Qo'lda yozish uchun: venv/bin/python tools/set_hrm_token.py --crm '<JWT>'
CRM_TOKEN=

# --- Ulanishlar: foydalanuvchining O'Z HRM / CRM hisobi ----------------------
# "+" menyusidagi "Ulanishlar": har bir odam o'z logini va paroli bilan
# kiradi, va chatga UNING tokeni beriladi - yuqoridagi umumiy HRM_TOKEN /
# agent sessiyasi esa ulanmaganlar uchun zahira bo'lib qoladi.
# PAROL SAQLANMAYDI. Tokenlar `data/connectors/tokens.json` da (600 huquq).
#
# HRM: `POST /api/authenticate` -> JWT 10 soat. Bo'sh bo'lsa HRM ulanishi
# o'chiq (menyuda "serverda sozlanmagan").
HRM_BASE_URL=https://hrm-api.brb-tech.uz
HRM_TIMEOUT=10
# Token muddati shundan (soniya) kam qolganda chatga BERILMAYDI - odam
# qayta kiradi. Savol-javob bir necha daqiqa cho'zilishi mumkin.
HRM_TOKEN_MARGIN=300
# CRM: Keycloak parol granti (offline_access) -> refresh_token, keyin
# CRM_BASE_URL/api/auth/refresh -> access_token (300 s). CRM_BASE_URL
# yuqorida - agent sessiyasi bilan bir xil manzil.
CRM_IDP_TOKEN_URL=https://myid.brb-tech.uz/auth/realms/brb-realm/protocol/openid-connect/token
CRM_CLIENT_ID=crm-client
# Ilova siri - GIT'GA TUSHMAYDI.
CRM_CLIENT_SECRET=
# access_token muddati shundan kam qolganda savol oldidan yangilanadi.
CRM_TOKEN_MARGIN=180

# --- STT varianti: qaysi xizmat ishlatiladi ----------------------------------
# `router` - 1-variant, ichki STT Router (yuqorida, STT_BASE_URL).
# `gapi`   - 2-variant, console.gapi.uz.
#
# IKKALASI HAM QOLADI. Qaytarish uchun kod o'zgartirilmaydi: pastdagi
# STT_PROVIDER qatorini o'chirib, xizmatni qayta ishga tushirish yetadi -
# koddagi default `router`.
#
# GAPI faqat O'ZBEK tilini biladi (matn faqat lotin yozuvida). `ru`/`en`
# uchun unda model yo'q, shuning uchun ular baribir Router'ga boradi -
# ya'ni 2-variantga o'tish rus yoki ingliz interfeysini buzmaydi.
#
# O'lchangan (2026-09-22, ayni audioda): Router 0.13 s, GAPI 1.22 s
# mediana. GAPI bosh harf va tinish belgisi qo'yadi; Router lotin
# kichik harfda qaytaradi.
STT_PROVIDER=router
# UYG'OTISH SO'ZI uchun ALOHIDA tanlov, va koddagi default `router`.
#
# `gapi` qilib qo'yish mumkin va u ISHLAYDI (o'lchangan: aniqligi Router'dan
# yaxshi - Router bir holatda "Salom Venera, yordam bering"ni butunlay
# o'tkazib yubordi). Lekin narxni bilib turib tanlash kerak:
#
#   * tinglagich daqiqasiga 24 tagacha parcha yuboradi (COOLDOWN_MS 2500),
#     GAPI limiti esa 60 yuklash/daqiqa - va o'sha tokendan foydalanuvchining
#     SAVOLI ham o'tadi;
#   * bitta parcha = 0.03 g (1 g = 1 audio-daqiqa), kunlik chegara 480 g;
#   * jonli jurnalda parchalarning ~71 foizi uyg'otish so'zi EMAS, ya'ni
#     pulning katta qismi "bu u emas" javobiga ketadi;
#   * Router shu ishni 0.1 sekundda va BEPUL qiladi.
#
# Himoya o'rnatilgan (kod o'zi qiladi, sozlash kerak emas): uyg'otish
# ALOHIDA slot va qisqa vaqt byudjeti oladi (savolning ikki sloti tegilmaydi),
# chegaradan oshgan parcha RAD ETILMAYDI - bepul Router'ga tushadi, va GAPI
# yiqilsa ham uyg'otish Router bilan ishlashda davom etadi.
STT_WAKE_PROVIDER=router
#
# MAXFIYLIK - BILIB QO'YISH KERAK. `gapi` tanlangan yo'l orqali ovoz ICHKI
# TARMOQDAN CHIQADI va uchinchi tomon xizmatiga (console.gapi.uz) boradi.
# 1-variantda audio 10.10.50.4 dan tashqariga chiqmaydi. Uyg'otish yo'li
# bunda alohida o'rinda turadi: u FON ishi va har chat varag'ida default
# yoqiq, ya'ni `STT_WAKE_PROVIDER=gapi` xona shovqinining bo'laklarini
# tashqariga muntazam yuborish degani. Yozuvlar GAPI da 30 kun saqlanadi.
# Xodimlar ovozi shaxsiy ma'lumot - bu tanlovni HR/xavfsizlik bilan
# kelishish kerak.
#
# Uyg'otish uchun pullik so'rovlar byudjeti (daqiqada). Chegaradan oshganda
# so'rov rad etilmaydi - bepul Router'ga tushadi, ya'ni bu HISOBNI cheklaydi,
# xizmatni emas. 30: bitta halol varaq (24/daqiqa) erkin o'tadi. 45: token
# chegarasi 60/daqiqadan past, foydalanuvchining savoli uchun joy qoladi.
WAKE_GAPI_PER_ACTOR_MIN=30
WAKE_GAPI_TOTAL_MIN=45
# GAPI tokeni - kabinetdan (console.gapi.uz -> loyiha -> API tokenlar).
# Loyihaga bog'langan: vazifalar, lug'at va ovozlar shu loyiha ichida.
GAPI_API_KEY=
GAPI_BASE_URL=https://console.gapi.uz/v1
GAPI_TIMEOUT=60
# O'lchangan (2026-09-22, jonli GAPI): 16-20 parallel so'rov muammosiz,
# 24 da BUTUNLAY qotadi (0/24), 32 da 1/32 - va qotgan so'rovning ham puli
# ketadi. Chegaradan oshgan portlash o'sha tokendagi boshqa so'rovlarni ham
# cho'zadi (bitta so'rov 1 s o'rniga 24 s ketdi). Barqaror rejimda baribir
# 60 yuklash/daqiqa ushlaydi, ya'ni bu sonni oshirishning ma'nosi kam.
GAPI_MAX_CONCURRENT=2

# --- Kutish ovozi (ovozli suhbatda jimlikni to'ldiradi) ---------------------
# MUAMMO. Ovozli suhbatda HRM/CRM javobi darhol kelmaydi: o'lchangan `hrm`
# 3-4 s, `rules` 15.7 s mediana va 38.7 s p90. Shu paytda Venera jim turadi
# va odam "eshitdimi?" deb savolni qaytaradi yoki panelni tashlab ketadi.
#
# TARTIB:
#   t=0     STT matni -> HRM/CRM ga (javob) + PARALLEL -> gemma (tasnif)
#   t~0.8   gemma: mavzu|ohang -> mos TAYYOR ovoz o'ynaladi
#   har 9 s javob hali yo'q bo'lsa - keyingi tayyor ovoz (eng ko'pi 4 ta)
#   javob   joriy ovoz OXIRIGACHA eshittiriladi, keyin javob TTS orqali
#
# 44 ta ovoz (8 mavzu x 2 ohang, birinchi va davomi, variantlar bilan)
# ishga tushganda fonda bir marta sintez qilinadi (~55 s) va diskda saqlanadi.
# Gaplar `app/services/hold.py` da - ularda fakt, raqam va va'da YO'Q, buni
# testlar qo'riqlaydi.
#
# Model gapni YOZMAYDI, faqat ro'yxatdan TANLAYDI: ya'ni javobni to'qib
# qo'ya olmaydi. Model ulgurmasa (1.2 s) yoki ishlamasa - kalit so'z jadvali
# tanlaydi, ohang esa doim "oddiy" (jadval ohangni noto'g'ri o'qiydi).
#
# O'chirish: HOLD_ENABLED=false.
HOLD_ENABLED=true
# Tasnifni shuncha kutamiz, keyin birinchi ovozni jadval tanlaydi.
HOLD_FIRST_MS=1200
# Javob kelmasa har shuncha vaqtda keyingi ovoz.
HOLD_REPEAT_MS=9000
# Bitta savol uchun eng ko'pi.
HOLD_MAX=4
#
# MAXFIYLIK - BILIB QO'YISH KERAK. Tasniflovchi model TASHQI xizmatda (Ollama
# Cloud), ya'ni foydalanuvchining SAVOLI internetga chiqadi - GAPI STT bilan
# bir toifada. Javob, HRM/CRM ma'lumotlari va hujjatlar chiqmaydi.
#
# Ollama kaliti. `.env` da tarixiy sabab bilan VENERA_API_URL deb yozilgan
# (nomi noto'g'ri - u URL emas, token), shuning uchun ikkala nom ham o'qiladi
# va OLLAMA_API_KEY birinchi o'rinda turadi.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT=2.5

# --- Telegram bot (savol-javob Telegram chatining o'zida, `app/bot/`) ---
# @BotFather bergan token. Bo'sh bo'lsa bot o'chiq. SIR - git'ga tushmaydi.
# Mini app `initData` imzosi ham shu token bilan tekshiriladi.
TELEGRAM_BOT_TOKEN=
# Tokenni o'chirmasdan botni to'xtatish: TELEGRAM_BOT_ENABLED=false
# TELEGRAM_LINK_DAYS=30          # ulanish muddati (mini app ochilganda yangilanadi)
# TELEGRAM_CHAT_IDLE_HOURS=6     # shuncha soat jimlikdan keyin yangi suhbat
# TELEGRAM_VOICE_MAX_SEC=300     # ovozli xabar chegarasi

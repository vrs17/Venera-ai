# Venera API - muhit o'zgaruvchilari
# Nusxa oling:  cp .env.example .env
# `.env` git'ga TUSHMAYDI.

# Token imzolash kaliti. PRODUCTION'DA ALBATTA O'ZGARTIRING:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# Token amal qilish muddati (soat)
TOKEN_TTL_HOURS=12

# Batafsil log
DEBUG=false

# CORS - odatda BO'SH qoldiriladi. nginx frontend va /api ni bir xil
# originda ko'rsatadi, ya'ni CORS kerak emas. Faqat frontend boshqa
# domenda ishlasa to'ldiring, masalan:
# CORS_ORIGINS=["http://localhost:5173"]

# --- TTS (matnni ovozga o'girish) ---
# Sir TTS serverining `backend/server/.env` -> AUTH_CLIENTS dan olinadi.
# BO'SH qoldirilsa ovoz sintezi o'chiq bo'ladi (endpoint 503), qolgan
# hamma narsa ishlayveradi. Bu qiymat GIT'GA HECH QACHON TUSHMAYDI.
TTS_CLIENT_ID=frontend
TTS_CLIENT_SECRET=
# Ovoz: uz_female_calm (ayol) | uz_male_news (erkak)
TTS_VOICE=uz_female_calm
# Bo'lakning maqsadli davomiyligi (soniya). Jonli suhbat uchun 1.0-2.0.
TTS_CHUNK_SEC=1.5

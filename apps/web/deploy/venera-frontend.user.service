# venera-frontend.service
# Serves the Venera frontend (Vue 3 SPA) from an unprivileged nginx container.
# Modeled on the podman-generate-systemd unit that served this host before.
#
# Source:   /home/ymamajonov/Venera/apps/web
# Image:    localhost/venera-frontend:latest  (rollback anchor: :0.2.3)
# Redeploy: cd /home/ymamajonov/Venera/apps/web \
#             && podman build -t localhost/venera-frontend:latest . \
#             && systemctl --user restart venera-frontend.service

[Unit]
Description=Venera frontend (nginx container, port 5173)
Documentation=file:///home/ymamajonov/Venera/docs/web-origin.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers
# Guard against a port clash on 0.0.0.0:5173. This names the retired unit that
# is still installed (disabled) as the rollback path — it is a live systemd
# object name, not branding, so it must match the unit that actually exists.
Conflicts=container-brb-frontend.service

# Desktop yuklab olish papkasi read-only bind-mount qilinadi:
#   %h/.local/share/venera/downloads  ->  /usr/share/nginx/downloads  (ro)
#
# NEGA $HOME, /var/www EMAS: bu ROOTLESS user-service. /var/www root'niki, uni
# mount qilish uchun sudo kerak bo'ladi va konteyner ichidagi nginx (uid 101 ->
# hostda subuid) uni o'qiy olmay 403 beradi. Foydalanuvchi papkasi ikkala
# muammoni ham yo'q qiladi.
#
# `:z` - SELinux yoqilgan hostlarda o'qish huquqi uchun.
#
# Papkani oldindan yarating va relizni nusxalang:
#     mkdir -p ~/.local/share/venera/downloads
#     cp release/version.json release/Venera-*.exe ~/.local/share/venera/downloads/
#
# Alohida update serveri YO'Q: sayt ham, desktop auto-update ham shu konteyner
# bergan llm.brb-tech.uz/download/ dan o'qiydi. Ikkinchi manzil qo'shmang -
# aks holda ikki xil versiya ko'rsatilishi mumkin.
# API MANZILI. Endi o'z backend'imiz (apps/api) - 10.10.50.9 dagi boshqa
# jamoaning serveri EMAS.
#
# `host.containers.internal` - konteyner ichidan HOST ga murojaat. Backend
# host'da 127.0.0.1:8000 da turadi va tashqi tarmoqqa ochilmagan, shuning
# uchun unga faqat shu nginx bora oladi.
#
# Agar podman versiyasi bu nomni bilmasa, o'rniga host'ning podman
# ko'prigidagi manzilini yozing (odatda 10.0.2.2 yoki `ip -4 addr show
# podman0`) yoki `--network=host` bilan ishga tushiring.
[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%n.ctr-id
# `--network slirp4netns:allow_host_loopback=true` MAJBURIY.
#
# Root'siz podman default holda konteynerdan HOST LOOPBACK ga yo'lni YOPADI.
# Backend esa ataylab 127.0.0.1:8000 da turadi (tashqariga ochilmasin deb),
# shuning uchun bu bayroqsiz nginx unga yeta olmaydi va `/api/*` ning HAMMASI
# 502 qaytaradi. Log'da: "connect() failed (101: Network is unreachable)".
#
# Sayt ochiladi, SPA yuklanadi - faqat login ishlamaydi. Shuning uchun buzilish
# darhol ko'zga tashlanmaydi.
#
# `mtu=1500` HAM MAJBURIY (2026-10-10 o'lchangan). Podman default'i 65520 va u
# bilan nginx -> backend yo'lida ~64 KB dan katta HAR BIR javob AYNAN 5 s kech
# yetib keladi (TTS bo'lagi, eksport, uzun tarix). Backend javobni millisekundda
# yozib bo'ladi - baytlar slirp4netns ichida turib qoladi. Sabab (tcpdump bilan
# isbotlangan): libslirp segmentni 32768 bayt bilan cheklaydi va window scaling
# bilmaydi; birinchi 32768 baytdan keyin nginx tomoni 32712 baytlik oyna e'lon
# qiladi - bu bitta segmentdan ham, eng katta oynaning yarmidan ham kichik.
# libslirp (BSD TCP) "silly window" himoyasi bilan yubormay turadi va faqat
# persist taymerida (minimal 5 s) davom etadi. MTU 1500 da segment ~1460 bayt,
# oyna undan ancha katta - to'xtash yo'q; bizdagi hajmlarda tezlik farqi
# sezilmaydi (20 MB javob ~0.03 s). nginx'dagi `proxy_buffering` bunga TA'SIR
# QILMAYDI - o'chirib ko'rilgan, 5 s qolgan.
#
# PROD'DAGI O'RNATILGAN UNIT bu fayldan farq qiladi: unda eski Mini App'ning
# ikkita mount'i bor (`~/.local/share/venera-tg-conf/default.conf.template` ->
# /etc/nginx/templates/..., `~/.local/share/venera-tg` -> /usr/share/nginx/tg).
# 2026-10-10 tekshirilgan: mount qilingan template image'dagisi bilan BAYTMA-BAYT
# bir xil, /tg/ esa image ichidagi tg-app.html dan beriladi - ya'ni ikkalasi
# hozir ortiqcha. Shunga qaramay prod'ni yangilashda bu faylni ustiga
# KO'CHIRMANG: faqat `--network` qatorini tahrirlang (template keyin
# o'zgartirilgan bo'lsa, mount'siz u jimgina yo'qoladi).
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=no-conmon \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name venera-frontend \
    --network slirp4netns:allow_host_loopback=true,mtu=1500 \
    -p 0.0.0.0:5173:8080 \
    -e API_UPSTREAM=http://host.containers.internal:8000 \
    -e API_READ_TIMEOUT=120s \
    -v %h/.local/share/venera/downloads:/usr/share/nginx/downloads:ro,z \
    localhost/venera-frontend:latest
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target

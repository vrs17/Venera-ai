# venera-frontend.service
# Serves the Venera frontend (Vue 3 SPA) from an unprivileged nginx container.
# Modeled on the podman-generate-systemd unit that served this host before.
#
# Source:   /home/ymamajonov/Venera/apps/web
# Image:    localhost/venera-frontend:latest  (rollback anchor: :0.2.3)
# Redeploy: cd /home/ymamajonov/Venera/apps/web \
#             && podman build -t localhost/venera-frontend:latest . \
#             && systemctl --user restart venera-frontend.service

[Unit]
Description=Venera frontend (nginx container, port 5173)
Documentation=file:///home/ymamajonov/Venera/docs/web-origin.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers
# Guard against a port clash on 0.0.0.0:5173. This names the retired unit that
# is still installed (disabled) as the rollback path — it is a live systemd
# object name, not branding, so it must match the unit that actually exists.
Conflicts=container-brb-frontend.service

# Desktop yuklab olish papkasi read-only bind-mount qilinadi:
#   %h/.local/share/venera/downloads  ->  /usr/share/nginx/downloads  (ro)
#
# NEGA $HOME, /var/www EMAS: bu ROOTLESS user-service. /var/www root'niki, uni
# mount qilish uchun sudo kerak bo'ladi va konteyner ichidagi nginx (uid 101 ->
# hostda subuid) uni o'qiy olmay 403 beradi. Foydalanuvchi papkasi ikkala
# muammoni ham yo'q qiladi.
#
# `:z` - SELinux yoqilgan hostlarda o'qish huquqi uchun.
#
# Papkani oldindan yarating va relizni nusxalang:
#     mkdir -p ~/.local/share/venera/downloads
#     cp release/version.json release/Venera-*.exe ~/.local/share/venera/downloads/
#
# Keyinchalik ccs.venera.uz update serveri sozlansa, IKKALASI BIR PAPKANI
# ko'rsatishi kerak (update server'ning nginx root'ini shu yerga qarating yoki
# mount manzilini o'zgartiring) - aks holda sayt va auto-update ikki xil
# versiyani ko'rsatib qoladi.
[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/%n.ctr-id
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=no-conmon \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name venera-frontend \
    -p 0.0.0.0:5173:8080 \
    -e API_UPSTREAM=http://10.10.50.9:8080 \
    -e API_READ_TIMEOUT=120s \
    -v %h/.local/share/venera/downloads:/usr/share/nginx/downloads:ro,z \
    localhost/venera-frontend:latest
ExecStop=/usr/bin/podman stop --ignore --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target

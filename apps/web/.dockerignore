# Keep the build context small and reproducible — never ship local cruft or secrets.
node_modules/
dist/
.git/
.gitignore
# `.env` stays IN the context: it is the app's single env file and `vite build`
# reads it (no secrets there). Stray copies (.env.local, .env.bak, ...) stay out.
.env.*
*.local
.vite/
.DS_Store
npm-debug.log*
# docs / deploy material not needed inside the image build context
deploy/*.md
deploy/*.service
deploy/gitlab-ci.full.yml
*.md
run_dev.bat
.claude/

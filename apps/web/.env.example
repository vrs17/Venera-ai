# Spring Boot backend that exposes POST /api/v1/chat/pipeline.
# Two ways to run the frontend:
#
#   1. Direct mode (default). Leave VITE_API_BASE set to the absolute URL;
#      the browser calls Spring Boot directly. The backend must allow CORS
#      from the frontend's origin.
#
#   2. Proxy mode. Set VITE_API_BASE="" and the fetch calls become relative.
#      Vite's dev server forwards /api to VITE_API_TARGET (also defaults to
#      the address below if unset). Useful when CORS is not yet configured
#      on the backend. Production builds in this mode need a reverse proxy
#      in front of the static bundle.
VITE_API_BASE=http://10.10.50.9:8080
# VITE_API_TARGET=http://10.10.50.9:8080

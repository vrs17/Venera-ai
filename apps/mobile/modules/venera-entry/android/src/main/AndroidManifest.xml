<?xml version="1.0" encoding="utf-8"?>
<!--
  venera-entry manifest qismi (spec 2.2). Gradle ilova manifestiga birlashtiradi.

  RecordLauncherActivity - ikkinchi, IXTIYORIY launcher belgisi "Yozish".
    android:enabled="false": foydalanuvchi Sozlamalar > Tez yozish da yoqmaguncha
    ko'rinmaydi. Samsung "Yon tugma > Ikki marta bosish > Ilovani ochish" shu
    belgini tanlay oladi. Shaffof, tarixda qolmaydi, darhol deep link yuborib yopiladi.
    Belgisi adaptive (mipmap-anydpi-v26): rangli fon + oq mikrofon; oq ic_record faqat plitka uchun.

  RecordTileService - Quick Settings "Yozish" plitkasi (toggle: bo'sh -> boshlash,
    yozilmoqda -> to'xtatish).

  RecordKeyService - "Maxsus imkoniyatlar" xizmati: ovozni pasaytirish tugmasini ikki
    marta bosish = boshlash/to'xtatish. Foydalanuvchi Android sozlamasida o'zi yoqadi.

  Qo'ng'iroq yozuvlari (2026-10-10, CallImport.kt):
  READ_MEDIA_AUDIO (Android 13+) / READ_EXTERNAL_STORAGE (12 va pastda, maxSdk 32) -
    Samsung Telefon yozgan Recordings/Call/ fayllarini MediaStore'dan o'qish uchun.
    Ruxsatni JS "Qo'ng'iroqlar" bo'limini ochganda so'raydi (PermissionsAndroid).
    DIQQAT: READ_EXTERNAL_STORAGE app.config.ts blockedPermissions ro'yxatiga qaytarilmasin -
    u yerdagi tools:node="remove" shu e'lonni ham o'chirib, Android 8-12 da ro'yxatni bo'sh qoldiradi.

  ImportActivity - "Ulashish -> Barno AI": audio/* (bitta yoki bir nechta fayl).
    Shaffof, tarixda qolmaydi: fayllarni filesDir/imports/ ga nusxalab, asosiy ilovani
    venera-rec://import?files=... bilan ochadi. NIMA UCHUN faqat audio/*:
    application/ogg (Telegram ovozli xabari) va video/mp4 ni server qabul qilmaydi,
    video/mp4 esa Barno'ni har bir video ulashish ro'yxatiga chiqarib qo'yardi.
    configChanges - burilishda activity qayta yaratilib import ikki marta ketmasin.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32" />

  <application>
    <activity
      android:name="uz.brbtech.venera.entry.ImportActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection|fontScale"
      android:excludeFromRecents="true"
      android:exported="true"
      android:label="@string/venera_entry_import_label"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="audio/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="audio/*" />
      </intent-filter>
    </activity>

    <activity
      android:name="uz.brbtech.venera.entry.RecordLauncherActivity"
      android:enabled="false"
      android:excludeFromRecents="true"
      android:exported="true"
      android:icon="@mipmap/venera_entry_ic_record_launcher"
      android:label="@string/venera_entry_launcher_label"
      android:noHistory="true"
      android:roundIcon="@mipmap/venera_entry_ic_record_launcher"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <service
      android:name="uz.brbtech.venera.entry.RecordTileService"
      android:exported="true"
      android:icon="@drawable/ic_record"
      android:label="@string/venera_entry_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
        android:name="android.service.quicksettings.TOGGLEABLE_TILE"
        android:value="true" />
    </service>

    <service
      android:name="uz.brbtech.venera.entry.RecordKeyService"
      android:exported="true"
      android:label="@string/venera_entry_key_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/venera_entry_key_service" />
    </service>
  </application>
</manifest>

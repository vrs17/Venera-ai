# --- Python (apps/desktop) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
*.spec.bak
config.yaml
logs/
apps/desktop/packaging/windows/update_url.txt

# --- Node (apps/web) ---
node_modules/
.vite/
*.local

# --- Build natijalari ---
build/
dist/

# --- Maxfiy sozlamalar ---
.env

# --- Chiqarilgan artefaktlar ---
# .exe fayllar git'da saqlanmaydi (har biri ~45 MB).
# Ular diskda qoladi, faqat kuzatilmaydi. release/version.json esa kuzatiladi.
release/*.exe
release/*.zip
publish/*.exe

# --- Uyg'otish so'zi jurnali ---
# OVOZ YOZUVLARI. Bu odamlarning ovozi - shaxsiy ma'lumot, va u hech qachon
# repoga tushmasligi kerak. Papka diagnostika uchun, `WAKE_LOG_ENABLED=false`
# bilan butunlay o'chiriladi.
apps/api/data/

# --- Audio ---
*.wav
# ISTISNO: salomlashish audiosi test namunasi emas, BUILD KIRISHI -
# `greeting.ts` uni import qiladi, ya'ni fayl bo'lmasa `vite build` umuman
# yiqiladi. `tools/make_greeting.py` bilan qayta yasaladi.
!apps/web/src/assets/greeting-uz.wav
!apps/desktop/tests/fixtures/*.wav

# --- OS ---
.DS_Store
Thumbs.db

# --- Backend (apps/api) ---
# Haqiqiy foydalanuvchilar va sirlar. Namunalar (.example) git da qoladi.
apps/api/config/users.yaml
apps/api/.env
# Nusxalar ham: `.env.bak`, `.env.local`, `.env.2026-09-08` - ular ham
# SECRET_KEY va TTS sirini saqlaydi, lekin yuqoridagi qator ularni
# QAMRAMAYDI va ular jimgina commit'ga tushib ketishi mumkin.
apps/api/.env.*
apps/api/venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Swagger UI artefaktlari - Dockerfile yuklab oladi, git da saqlanmaydi.
# Swagger UI ning YUKLAB OLINADIGAN fayllari (docs/deploy-api.md, 3-qadam).
apps/api/app/static/swagger-ui*.js
apps/api/app/static/swagger-ui*.css
# DIQQAT: `swagger-init.js` BUNGA KIRMAYDI - u bizning manba kodimiz.
# Umumiy `*.js` qoidasi uni ham yutib yuborardi va toza klonda `/api/docs`
# 503 qaytarardi.

# Ovoz paneli dizayn ma'lumotnomasi - 10 MB, koddan import qilinmaydi.
# CSS varianti VoicePanel.vue da; GIF faqat solishtirish uchun diskda turadi.
apps/web/src/assets/voice.gif

# Ovoz paneli uchun mos yozuvlar rasmlari - repoda kerak emas
apps/web/src/assets/[0-9].png

# --- Tahrirlashdan oldingi nusxalar ---
# `nginx.container.conf.bak-2026-09-10` kabi fayllar - qo'lda olingan
# zaxira, manba emas. Ular diskda qoladi, lekin repoga tushmaydi.
*.bak-*
